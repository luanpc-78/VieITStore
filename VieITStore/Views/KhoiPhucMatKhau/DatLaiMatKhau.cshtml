@model DatLaiMatKhauVM
@{ Layout="_LayoutAuth"; ViewData["Title"]="Đặt lại mật khẩu"; }
<div class="auth-shell"><section class="auth-visual"><div><span class="auth-kicker">Bảo mật tài khoản</span><h1>Tạo mật khẩu mới.</h1><p>Chọn mật khẩu mạnh và không chia sẻ mã xác nhận.</p></div></section><section class="auth-card"><a class="auth-back" asp-controller="TaiKhoan" asp-action="DangNhap"><i class="fas fa-arrow-left"></i> Quay lại đăng nhập</a><h2>Đặt lại mật khẩu</h2>@if(TempData["Info"]!=null){<div class="alert alert-info">@TempData["Info"]</div>}@if(TempData["DemoResetCode"]!=null){<div class="alert alert-warning">Mã xác nhận thử nghiệm: <strong>@TempData["DemoResetCode"]</strong></div>}<form asp-action="DatLaiMatKhau" method="post" data-auth-form><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="Email" type="hidden"/><div class="mb-3"><label asp-for="MaXacNhan" class="form-label"></label><div class="auth-input"><i class="fas fa-key"></i><input asp-for="MaXacNhan" class="form-control" inputmode="numeric" maxlength="6"/></div><span asp-validation-for="MaXacNhan" class="text-danger"></span></div><div class="mb-3"><label asp-for="MatKhauMoi" class="form-label"></label><div class="auth-input"><i class="fas fa-lock"></i><input asp-for="MatKhauMoi" class="form-control"/><button type="button" class="password-toggle" data-password-toggle aria-label="Hiện mật khẩu"><i class="fas fa-eye"></i></button></div><span asp-validation-for="MatKhauMoi" class="text-danger"></span></div><div class="mb-4"><label asp-for="XacNhanMatKhau" class="form-label"></label><div class="auth-input"><i class="fas fa-shield-halved"></i><input asp-for="XacNhanMatKhau" class="form-control"/><button type="button" class="password-toggle" data-password-toggle aria-label="Hiện mật khẩu"><i class="fas fa-eye"></i></button></div><span asp-validation-for="XacNhanMatKhau" class="text-danger"></span></div><button class="btn auth-submit"><span data-submit-label>Đổi mật khẩu</span><span class="spinner-border spinner-border-sm d-none" data-submit-spinner></span></button></form></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
