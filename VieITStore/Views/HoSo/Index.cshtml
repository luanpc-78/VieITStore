@model HoSoVM
@{
    ViewData["Title"] = "Hồ sơ của tôi";
}

<div class="container py-4">
    <h3 class="mb-4">Hồ sơ của tôi</h3>
    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm"><div class="card-body">
                <h5 class="card-title mb-3">Thông tin cá nhân</h5>
                <form asp-action="Index" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3"><label asp-for="HoTen" class="form-label">Họ tên</label><input asp-for="HoTen" class="form-control" /><span asp-validation-for="HoTen" class="text-danger"></span></div>
                    <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
                    <div class="mb-3"><label asp-for="SoDienThoai" class="form-label">Số điện thoại</label><input asp-for="SoDienThoai" class="form-control" /><span asp-validation-for="SoDienThoai" class="text-danger"></span></div>
                    <div class="row g-3">
                        <div class="col-md-6"><label asp-for="GioiTinh" class="form-label">Giới tính</label><select asp-for="GioiTinh" class="form-select"><option value="">-- Chọn --</option><option>Nam</option><option>Nữ</option><option>Khác</option></select></div>
                        <div class="col-md-6"><label asp-for="NgaySinh" class="form-label">Ngày sinh</label><input asp-for="NgaySinh" class="form-control" /></div>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">Lưu hồ sơ</button>
                </form>
            </div></div>
        </div>

        <div class="col-lg-7">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Địa chỉ nhận hàng</h4>
                <button class="btn btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#addAddress">Thêm địa chỉ</button>
            </div>
            @if (Model.DiaChis.Count == 0) { <div class="alert alert-light border">Bạn chưa có địa chỉ nhận hàng.</div> }
            @foreach (var address in Model.DiaChis)
            {
                <div class="card shadow-sm mb-2"><div class="card-body">
                    <div class="d-flex justify-content-between gap-3">
                        <div>
                            <strong>@address.HoTenNguoiNhan — @address.SoDienThoai</strong>
                            @if (address.LaMacDinh) { <span class="badge bg-success ms-2">Mặc định</span> }
                            <div class="text-muted mt-1">@address.DiaChiChiTiet, @address.PhuongXa, @address.QuanHuyen, @address.TinhThanh</div>
                        </div>
                        <form asp-action="XoaDiaChi" asp-route-id="@address.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa địa chỉ này?')">Xóa</button>
                        </form>
                    </div>
                </div></div>
            }

            <div id="addAddress" class="collapse mt-3">
                <div class="card border-primary"><div class="card-body">
                    <form asp-action="ThemDiaChi" method="post">
                        <div class="row g-2">
                            <div class="col-md-6"><input name="HoTenNguoiNhan" class="form-control" placeholder="Họ tên người nhận" required /></div>
                            <div class="col-md-6"><input name="SoDienThoai" class="form-control" placeholder="Số điện thoại" required /></div>
                            <div class="col-md-4"><input name="TinhThanh" class="form-control" placeholder="Tỉnh/thành" required /></div>
                            <div class="col-md-4"><input name="QuanHuyen" class="form-control" placeholder="Quận/huyện" required /></div>
                            <div class="col-md-4"><input name="PhuongXa" class="form-control" placeholder="Phường/xã" required /></div>
                            <div class="col-12"><input name="DiaChiChiTiet" class="form-control" placeholder="Số nhà, tên đường" required /></div>
                            <div class="col-12 form-check ms-2"><input name="LaMacDinh" value="true" type="checkbox" class="form-check-input" id="defaultAddress" /><label class="form-check-label" for="defaultAddress">Đặt làm mặc định</label></div>
                        </div>
                        <button type="submit" class="btn btn-success mt-3">Lưu địa chỉ</button>
                    </form>
                </div></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
