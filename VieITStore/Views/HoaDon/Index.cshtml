@model IReadOnlyList<HoaDon>
@{
    ViewData["Title"] = "Hóa đơn";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Danh sách hóa đơn</h2>
    </div>
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light"><tr><th>Số hóa đơn</th><th>Mã đơn hàng</th><th>Khách hàng</th><th>Ngày lập</th><th class="text-end">Tổng thanh toán</th><th></th></tr></thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Chưa có hóa đơn.</td></tr>
                }
                @foreach (var invoice in Model)
                {
                    <tr>
                        <td><strong>@invoice.SoHoaDon</strong></td>
                        <td>@invoice.DonHang?.MaDonHang</td>
                        <td>@invoice.KhachHang?.NguoiDung?.HoTen</td>
                        <td>@invoice.NgayLap.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">@invoice.ThanhTien.ToString("N0") đ</td>
                        <td class="text-end"><a asp-action="Details" asp-route-id="@invoice.Id" class="btn btn-sm btn-outline-primary">Xem / In</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
