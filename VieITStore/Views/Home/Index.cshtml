@model List<VieITStore.Models.Entities.SanPham>
@{
    ViewData["Title"] = "Trang chủ";
    var sanPhamMoi = ViewBag.SanPhamMoi as List<VieITStore.Models.Entities.SanPham>;
}

<!-- Hero Section -->
<div class="bg-dark text-white py-5 mb-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="display-4 fw-bold">Linh kiện điện tử <span class="text-warning">chính hãng</span></h1>
                <p class="lead">CPU, VGA, RAM, SSD, phụ kiện máy tính & điện thoại</p>
                <a href="@Url.Action("Index", "SanPham")" class="btn btn-warning btn-lg px-4">
                    <i class="fas fa-shopping-bag"></i> Mua ngay
                </a>
            </div>
            <div class="col-md-6 text-center">
                <i class="fas fa-microchip fa-10x text-secondary opacity-25"></i>
            </div>
        </div>
    </div>
</div>

<!-- Sản phẩm nổi bật -->
<div class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3><i class="fas fa-fire text-danger"></i> Sản phẩm nổi bật</h3>
        <a href="@Url.Action("Index", "SanPham")" class="text-decoration-none">Xem tất cả <i class="fas fa-arrow-right"></i></a>
    </div>
    <div class="row g-4">
        @foreach (var sp in Model)
        {
            <div class="col-md-3 col-sm-6">
                <div class="card product-card h-100">
                    <div class="position-relative">
                        @if (sp.GiaKhuyenMai.HasValue)
                        {
                            <span class="badge badge-sale position-absolute top-0 start-0 m-2">-@Math.Round((1 - sp.GiaKhuyenMai.Value / sp.GiaBan) * 100)%</span>
                        }
                        <img src="@(sp.HinhAnh ?? "/images/no-image.jpg")" class="card-img-top product-img" alt="@sp.TenSanPham">
                    </div>
                    <div class="card-body d-flex flex-column">
                        <small class="text-muted">@sp.DanhMuc?.TenDanhMuc</small>
                        <h6 class="card-title mt-1">@sp.TenSanPham</h6>
                        <div class="mt-auto">
                            @if (sp.GiaKhuyenMai.HasValue)
                            {
                                <span class="old-price">@sp.GiaBan.ToString("N0") đ</span>
                                <div class="price">@sp.GiaKhuyenMai.Value.ToString("N0") đ</div>
                            }
                            else
                            {
                                <div class="price">@sp.GiaBan.ToString("N0") đ</div>
                            }
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <small class="text-success"><i class="fas fa-check-circle"></i> Còn hàng</small>
                                <button class="btn btn-primary btn-sm" onclick="addToCart(@sp.Id)">
                                    <i class="fas fa-cart-plus"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Sản phẩm mới -->
<div class="container mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3><i class="fas fa-star text-warning"></i> Sản phẩm mới</h3>
    </div>
    <div class="row g-4">
        @foreach (var sp in sanPhamMoi ?? new List<VieITStore.Models.Entities.SanPham>())
        {
            <div class="col-md-3 col-sm-6">
                <div class="card product-card h-100">
                    <span class="badge bg-success position-absolute top-0 end-0 m-2">Mới</span>
                    <img src="@(sp.HinhAnh ?? "/images/no-image.jpg")" class="card-img-top product-img" alt="@sp.TenSanPham">
                    <div class="card-body d-flex flex-column">
                        <small class="text-muted">@sp.DanhMuc?.TenDanhMuc</small>
                        <h6 class="card-title mt-1">@sp.TenSanPham</h6>
                        <div class="mt-auto">
                            <div class="price">@sp.GiaBan.ToString("N0") đ</div>
                            <button class="btn btn-outline-primary btn-sm w-100 mt-2" onclick="addToCart(@sp.Id)">
                                <i class="fas fa-cart-plus"></i> Thêm vào giỏ
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Cam kết -->
<div class="container mb-5">
    <div class="row g-4 text-center">
        <div class="col-md-3">
            <div class="p-4 bg-white rounded shadow-sm">
                <i class="fas fa-truck fa-2x text-primary mb-2"></i>
                <h6>Giao hàng toàn quốc</h6>
                <small class="text-muted">1-3 ngày</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-4 bg-white rounded shadow-sm">
                <i class="fas fa-shield-alt fa-2x text-success mb-2"></i>
                <h6>Bảo hành chính hãng</h6>
                <small class="text-muted">Đổi trả 7 ngày</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-4 bg-white rounded shadow-sm">
                <i class="fas fa-tag fa-2x text-warning mb-2"></i>
                <h6>Giá cả cạnh tranh</h6>
                <small class="text-muted">Luôn khuyến mãi</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-4 bg-white rounded shadow-sm">
                <i class="fas fa-headset fa-2x text-info mb-2"></i>
                <h6>Hỗ trợ 24/7</h6>
                <small class="text-muted">Hotline: 1900 1234</small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <div id="cartAntiForgery" class="d-none">@Html.AntiForgeryToken()</div>
    <script>
        function addToCart(sanPhamId) {
            $.post('@Url.Action("ThemVaoGio", "GioHang")', { sanPhamId: sanPhamId, soLuong: 1, __RequestVerificationToken: $('#cartAntiForgery input').val() }, function (data) {
                if (data.success) {
                    updateCartCount();
                    alert(data.message);
                }
            }).fail(function (xhr) { alert(xhr.responseJSON?.message || 'Không thể thêm sản phẩm vào giỏ.'); });
        }
    </script>
}
