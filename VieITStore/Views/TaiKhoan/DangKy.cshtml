@model RegisterVM
@{ Layout = "_LayoutAuth"; ViewData["Title"] = "Đăng ký"; }
<div class="auth-shell">
    <section class="auth-visual"><div><span class="auth-kicker">Gia nhập VieITStore</span><h1>Mua sắm tiện lợi,<br/>an tâm mỗi ngày.</h1><p>Tạo tài khoản để quản lý đơn hàng và nhận hỗ trợ nhanh chóng.</p></div></section>
    <section class="auth-card auth-card-wide">
        <a class="auth-back" asp-controller="Home" asp-action="Index"><i class="fas fa-arrow-left"></i> Quay lại trang chủ</a><h2>Tạo tài khoản</h2><p class="text-muted">Chỉ mất ít phút để bắt đầu.</p>
        <form asp-action="DangKy" method="post" data-auth-form>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <div class="mb-3"><label asp-for="HoTen" class="form-label"></label><div class="auth-input"><i class="fas fa-user"></i><input asp-for="HoTen" class="form-control" autocomplete="name" placeholder="Nguyễn Văn An" /></div><span asp-validation-for="HoTen" class="text-danger"></span></div>
            <div class="row g-3"><div class="col-md-6"><label asp-for="Email" class="form-label"></label><div class="auth-input"><i class="fas fa-envelope"></i><input asp-for="Email" class="form-control" autocomplete="email" placeholder="ban@vidu.com" /></div><span asp-validation-for="Email" class="text-danger"></span></div><div class="col-md-6"><label asp-for="SoDienThoai" class="form-label"></label><div class="auth-input"><i class="fas fa-phone"></i><input asp-for="SoDienThoai" class="form-control" autocomplete="tel" placeholder="0901234567" /></div><span asp-validation-for="SoDienThoai" class="text-danger"></span></div></div>
            <div class="row g-3 mt-0"><div class="col-md-6"><label asp-for="MatKhau" class="form-label"></label><div class="auth-input"><i class="fas fa-lock"></i><input asp-for="MatKhau" class="form-control" autocomplete="new-password" placeholder="Ít nhất 8 ký tự"/><button type="button" class="password-toggle" data-password-toggle aria-label="Hiện mật khẩu"><i class="fas fa-eye"></i></button></div><span asp-validation-for="MatKhau" class="text-danger"></span></div><div class="col-md-6"><label asp-for="XacNhanMatKhau" class="form-label"></label><div class="auth-input"><i class="fas fa-shield-halved"></i><input asp-for="XacNhanMatKhau" class="form-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu"/><button type="button" class="password-toggle" data-password-toggle aria-label="Hiện mật khẩu"><i class="fas fa-eye"></i></button></div><span asp-validation-for="XacNhanMatKhau" class="text-danger"></span></div></div>
            <p class="auth-hint">Mật khẩu cần có ít nhất 8 ký tự, gồm chữ cái và chữ số.</p><button type="submit" class="btn auth-submit"><span data-submit-label>Đăng ký</span><span class="spinner-border spinner-border-sm d-none" data-submit-spinner></span></button>
        </form><p class="auth-switch">Đã có tài khoản? <a asp-action="DangNhap">Đăng nhập</a></p>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
