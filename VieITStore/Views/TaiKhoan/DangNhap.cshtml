@model LoginVM
@{ Layout = "_LayoutAuth"; ViewData["Title"] = "Đăng nhập"; }
<div class="auth-shell">
    <section class="auth-visual" aria-label="Giới thiệu VieITStore"><div><span class="auth-kicker">Chào mừng trở lại</span><h1>Công nghệ chính hãng,<br/>dịch vụ tận tâm.</h1><p>Đăng nhập để theo dõi đơn hàng, lưu địa chỉ và mua sắm nhanh hơn.</p></div></section>
    <section class="auth-card">
        <a class="auth-back" asp-controller="Home" asp-action="Index"><i class="fas fa-arrow-left"></i> Quay lại trang chủ</a>
        <h2>Đăng nhập</h2><p class="text-muted">Sử dụng email và mật khẩu của bạn.</p>
        <form asp-action="DangNhap" method="post" data-auth-form>
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <div class="mb-3"><label asp-for="Email" class="form-label"></label><div class="auth-input"><i class="fas fa-envelope"></i><input asp-for="Email" class="form-control" autocomplete="email" placeholder="ban@vidu.com" /></div><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="mb-2"><label asp-for="MatKhau" class="form-label">Mật khẩu</label><div class="auth-input"><i class="fas fa-lock"></i><input asp-for="MatKhau" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu" /><button type="button" class="password-toggle" data-password-toggle aria-label="Hiện mật khẩu"><i class="fas fa-eye"></i></button></div><span asp-validation-for="MatKhau" class="text-danger"></span></div>
            <div class="d-flex justify-content-between align-items-center mb-4"><div class="form-check"><input asp-for="GhiNho" class="form-check-input"/><label asp-for="GhiNho" class="form-check-label"></label></div><a asp-controller="KhoiPhucMatKhau" asp-action="QuenMatKhau">Quên mật khẩu?</a></div>
            <button type="submit" class="btn auth-submit"><span data-submit-label>Đăng nhập</span><span class="spinner-border spinner-border-sm d-none" data-submit-spinner></span></button>
        </form>
        <p class="auth-switch">Chưa có tài khoản? <a asp-action="DangKy">Đăng ký</a></p>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
