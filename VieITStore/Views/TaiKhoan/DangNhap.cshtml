@model VieITStore.Models.ViewModels.LoginVM
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="fas fa-microchip fa-3x text-primary"></i>
                        <h4 class="mt-2">VieITStore</h4>
                        <p class="text-muted">Đăng nhập tài khoản</p>
                    </div>

                    <form asp-action="DangNhap" method="post">
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                        
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="TenDangNhap" class="form-label"></label>
                            <input asp-for="TenDangNhap" class="form-control" placeholder="Tên đăng nhập">
                            <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MatKhau" class="form-label"></label>
                            <input asp-for="MatKhau" class="form-control" placeholder="Mật khẩu">
                            <span asp-validation-for="MatKhau" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="GhiNho" class="form-check-input">
                            <label asp-for="GhiNho" class="form-check-label"></label>
                        </div>

                    <hr class="my-4">
                    <div class="text-center">
                        <p>Chưa có tài khoản? <a href="@Url.Action("DangKy")">Đăng ký ngay</a></p>
                    </div>

                    <div class="alert alert-info mt-3">
                        <small><strong>Demo:</strong><br>
                        Admin: admin / admin123<br>
                        Nhân viên: nhanvien / nhanvien123</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
}
