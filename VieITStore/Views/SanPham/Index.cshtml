@model List<VieITStore.Models.Entities.SanPham>
@{
    ViewData["Title"] = "Sản phẩm";
    var danhMucs = ViewBag.DanhMucs as List<VieITStore.Models.Entities.DanhMuc>;
    var currentDanhMucId = ViewBag.DanhMucId as int?;
    var currentSort = ViewBag.CurrentSort as string;
    var search = ViewBag.Search as string;
}

<div class="container py-4">
    <div class="row">
        <!-- Sidebar lọc -->
        <div class="col-md-3">
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-filter"></i> Bộ lọc
                </div>
                <div class="card-body">
                    <h6>Danh mục</h6>
                    <div class="list-group list-group-flush">
                        <a href="@Url.Action("Index")" class="list-group-item list-group-item-action @(currentDanhMucId == null ? "active" : "")">
                            Tất cả sản phẩm
                        </a>
                        @foreach (var dm in danhMucs ?? new List<VieITStore.Models.Entities.DanhMuc>())
                        {
                            var isActive = currentDanhMucId == dm.Id;
                            <a href="@Url.Action("Index", new { danhMucId = dm.Id })"
                               class="list-group-item list-group-item-action @(isActive ? "active" : "")">
                                @dm.TenDanhMuc
                            </a>
                        }
                    </div>

                    <hr>
                    <h6>Sắp xếp</h6>
                    <select class="form-select" onchange="location = this.value;">
                        @{
                            var baseUrl = Url.Action("Index", new { danhMucId = currentDanhMucId, search = search });
                        }
                        <option value="@baseUrl" selected="@(string.IsNullOrEmpty(currentSort))">Mặc định</option>
                        <option value="@Url.Action("Index", new { danhMucId = currentDanhMucId, search = search, sort = "gia-thap" })" selected="@(currentSort == "gia-thap")">Giá thấp đến cao</option>
                        <option value="@Url.Action("Index", new { danhMucId = currentDanhMucId, search = search, sort = "gia-cao" })" selected="@(currentSort == "gia-cao")">Giá cao đến thấp</option>
                        <option value="@Url.Action("Index", new { danhMucId = currentDanhMucId, search = search, sort = "ban-chay" })" selected="@(currentSort == "ban-chay")">Bán chạy nhất</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Danh sách sản phẩm -->
        <div class="col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>Sản phẩm</h4>
                <form class="d-flex" method="get" style="width: 300px;">
                    <input type="hidden" name="danhMucId" value="@currentDanhMucId" />
                    <input type="text" name="search" class="form-control" placeholder="Tìm sản phẩm..." value="@search">
                    <button class="btn btn-primary ms-2"><i class="fas fa-search"></i></button>
                </form>
            </div>

            <div class="row g-3">
                @foreach (var sp in Model)
                {
                    <div class="col-md-4 col-sm-6">
                        <div class="card product-card h-100">
                            <a href="@Url.Action("ChiTiet", new { id = sp.Id })">
                                <img src="@(sp.HinhAnh ?? "/images/no-image.jpg")" class="card-img-top product-img" alt="@sp.TenSanPham">
                            </a>
                            <div class="card-body d-flex flex-column">
                                <small class="text-muted">@sp.ThuongHieu</small>
                                <h6 class="card-title">
                                    <a href="@Url.Action("ChiTiet", new { id = sp.Id })" class="text-decoration-none text-dark">@sp.TenSanPham</a>
                                </h6>
                                <div class="mt-auto">
                                    @if (sp.GiaKhuyenMai.HasValue)
                                    {
                                        <span class="old-price">@sp.GiaBan.ToString("N0") đ</span>
                                        <div class="price">@sp.GiaKhuyenMai.Value.ToString("N0") đ</div>
                                    }
                                    else
                                    {
                                        <div class="price">@sp.GiaBan.ToString("N0") đ</div>
                                    }
                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <small class="@(sp.SoLuongTon > 0 ? "text-success" : "text-danger")">
                                            <i class="fas fa-@(sp.SoLuongTon > 0 ? "check-circle" : "times-circle")"></i>
                                            @(sp.SoLuongTon > 0 ? $"Còn {sp.SoLuongTon}" : "Hết hàng")
                                        </small>
                                        <button class="btn btn-primary btn-sm" onclick="addToCart(@sp.Id)" disabled="@(sp.SoLuongTon <= 0)">
                                            <i class="fas fa-cart-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-search fa-3x text-muted mb-3"></i>
                    <h5>Không tìm thấy sản phẩm nào</h5>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <div id="cartAntiForgery" class="d-none">@Html.AntiForgeryToken()</div>
    <script>
        function addToCart(sanPhamId) {
            $.post('@Url.Action("ThemVaoGio", "GioHang")', { sanPhamId: sanPhamId, soLuong: 1, __RequestVerificationToken: $('#cartAntiForgery input').val() }, function (data) {
                if (data.success) {
                    updateCartCount();
                    alert(data.message);
                }
            }).fail(function (xhr) { alert(xhr.responseJSON?.message || 'Không thể thêm sản phẩm vào giỏ.'); });
        }
    </script>
}
