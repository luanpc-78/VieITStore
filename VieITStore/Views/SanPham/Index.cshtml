@model List<VieITStore.Models.Entities.SanPham>
@{
    ViewData["Title"] = "Sản phẩm";
    var danhMucs = ViewBag.DanhMucs as List<VieITStore.Models.Entities.DanhMuc> ?? new();
    var currentDanhMucId = ViewBag.DanhMucId as int?;
    var currentSort = ViewBag.CurrentSort as string;
    var search = ViewBag.Search as string;
}

<div class="catalog-shell">
    <div class="container store-container">
        <div class="catalog-header"><div class="section-kicker">Danh mục sản phẩm</div><h1 class="section-title">Khám phá sản phẩm</h1><p class="text-muted mb-0">Tìm linh kiện và phụ kiện phù hợp với nhu cầu của bạn.</p></div>
        <div class="catalog-toolbar mb-3">
            <button class="btn btn-outline-primary filter-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#catalogFilters"><i class="fas fa-sliders me-2"></i>Bộ lọc</button>
            <form method="get" role="search">
                <input type="hidden" name="danhMucId" value="@currentDanhMucId" />
                <label class="visually-hidden" for="catalogSearch">Tìm sản phẩm</label>
                <input id="catalogSearch" type="search" name="search" class="form-control" placeholder="Tìm theo tên hoặc mã sản phẩm..." value="@search" />
                <button class="btn btn-primary ms-2" type="submit"><i class="fas fa-search me-1"></i>Tìm</button>
            </form>
            <span class="text-muted small ms-lg-auto">@Model.Count kết quả</span>
        </div>

        <div class="row g-4">
            <aside class="col-lg-3">
                <div id="catalogFilters" class="filter-collapse collapse d-lg-block">
                    <div class="store-surface filter-panel p-3">
                        <h2 class="h6 fw-bold mb-3"><i class="fas fa-filter me-2 text-primary"></i>Danh mục</h2>
                        <div class="list-group list-group-flush mb-4">
                            <a asp-action="Index" asp-route-search="@search" asp-route-sort="@currentSort" class="list-group-item list-group-item-action @(currentDanhMucId == null ? "active" : "")">Tất cả sản phẩm</a>
                            @foreach (var dm in danhMucs) { <a asp-action="Index" asp-route-danhMucId="@dm.Id" asp-route-search="@search" asp-route-sort="@currentSort" class="list-group-item list-group-item-action @(currentDanhMucId == dm.Id ? "active" : "")">@dm.TenDanhMuc</a> }
                        </div>
                        <label for="catalogSort" class="form-label fw-bold">Sắp xếp</label>
                        <select id="catalogSort" class="form-select" onchange="location=this.value">
                            <option value="@Url.Action("Index", new { danhMucId = currentDanhMucId, search })" selected="@(string.IsNullOrEmpty(currentSort))">Mặc định</option>
                            <option value="@Url.Action("Index", new { danhMucId = currentDanhMucId, search, sort = "gia-thap" })" selected="@(currentSort == "gia-thap")">Giá thấp đến cao</option>
                            <option value="@Url.Action("Index", new { danhMucId = currentDanhMucId, search, sort = "gia-cao" })" selected="@(currentSort == "gia-cao")">Giá cao đến thấp</option>
                            <option value="@Url.Action("Index", new { danhMucId = currentDanhMucId, search, sort = "ban-chay" })" selected="@(currentSort == "ban-chay")">Bán chạy nhất</option>
                        </select>
                    </div>
                </div>
            </aside>
            <section class="col-lg-9" aria-label="Danh sách sản phẩm">
                @if (Model.Any()) { <div class="product-grid">@foreach (var sp in Model) { @await Html.PartialAsync("_ProductCard", sp) }</div> }
                else { <div class="empty-state"><i class="fas fa-magnifying-glass fa-3x text-muted mb-3"></i><h2 class="h4">Không tìm thấy sản phẩm</h2><p class="text-muted">Hãy thử từ khóa khác hoặc bỏ bớt bộ lọc.</p><a asp-action="Index" class="btn btn-primary">Xem tất cả sản phẩm</a></div> }
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <div id="cartAntiForgery" class="d-none">@Html.AntiForgeryToken()</div>
    <script>
        function addToCart(sanPhamId, button) {
            setCartButtonLoading(button, true);
            $.post('@Url.Action("ThemVaoGio", "GioHang")', { sanPhamId, soLuong: 1, __RequestVerificationToken: $('#cartAntiForgery input').val() })
                .done(function (data) { if (data.success) { updateCartCount(); showStoreToast(data.message); } else showStoreToast(data.message || 'Không thể thêm sản phẩm.', 'danger'); })
                .fail(function (xhr) { showStoreToast(xhr.responseJSON?.message || 'Không thể thêm sản phẩm vào giỏ.', 'danger'); })
                .always(function () { setCartButtonLoading(button, false); });
        }
    </script>
}
