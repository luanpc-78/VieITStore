@model SerialSanPhamVM
@{ ViewData["Title"] = "Cập nhật serial/IMEI"; }
<div class="card"><div class="card-header"><strong>Cập nhật serial/IMEI</strong></div><div class="card-body">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden" />
        <partial name="_Form" model="Model" />
        <div class="mt-4"><button class="btn btn-primary"><i class="fas fa-save"></i> Lưu thay đổi</button> <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Hủy</a></div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
