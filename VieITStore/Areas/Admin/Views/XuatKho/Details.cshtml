@model PhieuDieuChinhTonKho
@{
    ViewData["Title"] = $"Chi tiết phiếu {Model.MaPhieu}";
    var isIncrease = Model.LoaiGiaoDich == LoaiGiaoDichTonKho.DieuChinhTang;
    var typeText = Model.LoaiGiaoDich switch
    {
        LoaiGiaoDichTonKho.XuatNoiBo => "Xuất nội bộ",
        LoaiGiaoDichTonKho.HangLoi => "Hàng lỗi",
        LoaiGiaoDichTonKho.DieuChinhTang => "Điều chỉnh tăng",
        _ => "Điều chỉnh giảm"
    };
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Phiếu @Model.MaPhieu</h5>
        <span class="badge @(isIncrease ? "bg-success" : "bg-warning text-dark")">@typeText</span>
    </div>
    <div class="card-body">
        <div class="row mb-4">
            <div class="col-md-4"><strong>Ngày tạo:</strong><br />@Model.NgayTao.ToString("dd/MM/yyyy HH:mm:ss")</div>
            <div class="col-md-4"><strong>Người thực hiện:</strong><br />@Model.NguoiThucHien?.HoTen</div>
            <div class="col-md-4"><strong>Lý do/Ghi chú:</strong><br />@Model.LyDo</div>
        </div>

        <table class="table table-bordered">
            <thead class="table-light"><tr><th>STT</th><th>Mã SP</th><th>Sản phẩm</th><th class="text-center">Trước</th><th class="text-center">Thay đổi</th><th class="text-center">Sau</th></tr></thead>
            <tbody>
            @{ var number = 1; }
            @foreach (var item in Model.ChiTiets)
            {
                <tr>
                    <td>@number</td><td>@item.SanPham?.MaSanPham</td><td>@item.SanPham?.TenSanPham</td>
                    <td class="text-center">@item.SoLuongTruoc</td>
                    <td class="text-center fw-bold @(isIncrease ? "text-success" : "text-danger")">@(isIncrease ? "+" : "-")@item.SoLuongThayDoi</td>
                    <td class="text-center fw-bold">@item.SoLuongSau</td>
                </tr>
                number++;
            }
            </tbody>
        </table>
        <div class="alert alert-secondary mb-0"><i class="fas fa-lock"></i> Phiếu đã ghi nhận và không thể sửa hoặc xóa.</div>
    </div>
    <div class="card-footer text-end"><a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a><a asp-action="Create" class="btn btn-primary ms-2">Tạo phiếu mới</a></div>
</div>
