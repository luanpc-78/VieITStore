@model DonHang
@{ViewData["Title"]=$"Đơn hàng {Model.MaDonHang}";var terminal=Model.TrangThai is TrangThaiDonHang.HoanThanh or TrangThaiDonHang.DaHuy;}
@if(TempData["Info"]!=null){<div class="alert alert-info">@TempData["Info"]</div>}
<div class="d-flex justify-content-between mb-3"><div><h4>@Model.MaDonHang</h4><span class="badge bg-primary">@Model.KenhBan</span></div><a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a></div>
<div class="row g-3"><div class="col-lg-8"><div class="card mb-3"><div class="card-header"><strong>Sản phẩm</strong></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Sản phẩm</th><th class="text-end">Đơn giá</th><th class="text-end">Số lượng</th><th class="text-end">Thành tiền</th></tr></thead><tbody>@foreach(var x in Model.ChiTietDonHangs){<tr><td>@x.SanPham?.MaSanPham · @x.SanPham?.TenSanPham</td><td class="text-end">@x.DonGia.ToString("N0") đ</td><td class="text-end">@x.SoLuong</td><td class="text-end fw-bold">@x.ThanhTien.ToString("N0") đ</td></tr>}</tbody></table></div></div>
<div class="card"><div class="card-header"><strong>Xử lý trạng thái</strong></div><div class="card-body"><div class="mb-3">Hiện tại: <span class="badge fs-6 @(terminal?"bg-secondary":"bg-info text-dark")">@DonHangAdminController.StatusText(Model.TrangThai)</span></div>
@if(Model.TrangThai==TrangThaiDonHang.ChoXacNhan){<form asp-action="CapNhatTrangThai" method="post" class="d-inline"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="trangThai" value="@TrangThaiDonHang.DaXacNhan"/><button class="btn btn-primary">Xác nhận đơn</button></form>}
@if(Model.TrangThai==TrangThaiDonHang.DaXacNhan){<form asp-action="CapNhatTrangThai" method="post" class="d-inline"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="trangThai" value="@TrangThaiDonHang.DangChuanBi"/><button class="btn btn-primary">Bắt đầu chuẩn bị</button></form>}
@if(Model.TrangThai==TrangThaiDonHang.DangChuanBi){if(Model.HinhThucNhanHang==HinhThucNhanHang.NhanTaiCuaHang){<form asp-action="CapNhatTrangThai" method="post" class="d-inline"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="trangThai" value="@TrangThaiDonHang.HoanThanh"/><button class="btn btn-success">Đã giao tại cửa hàng</button></form>}else{<form asp-action="CapNhatTrangThai" method="post" class="d-inline"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="trangThai" value="@TrangThaiDonHang.DangGiao"/><button class="btn btn-primary">Bắt đầu giao</button></form>}}
@if(Model.TrangThai==TrangThaiDonHang.DangGiao){<form asp-action="CapNhatTrangThai" method="post" class="d-inline"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="trangThai" value="@TrangThaiDonHang.DaGiao"/><button class="btn btn-primary">Đã giao</button></form>}
@if(Model.TrangThai==TrangThaiDonHang.DaGiao){<form asp-action="CapNhatTrangThai" method="post" class="d-inline"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="trangThai" value="@TrangThaiDonHang.HoanThanh"/><button class="btn btn-success">Hoàn thành</button></form>}
@if(!terminal && Model.TrangThai!=TrangThaiDonHang.DaGiao){<form asp-action="CapNhatTrangThai" method="post" class="mt-3 border-top pt-3"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="trangThai" value="@TrangThaiDonHang.DaHuy"/><label class="form-label text-danger">Lý do hủy</label><div class="input-group"><input name="lyDoHuy" class="form-control" maxlength="500" required/><button class="btn btn-outline-danger" onclick="return confirm('Hủy đơn và hoàn tồn đúng một lần?')">Hủy đơn</button></div></form>}
@if(Model.TrangThai==TrangThaiDonHang.HoanThanh){<div class="d-flex gap-2 flex-wrap"><a asp-area="" asp-controller="HoaDon" asp-action="Create" asp-route-donHangId="@Model.Id" class="btn btn-outline-primary"><i class="fas fa-file-invoice"></i> Xem hoặc lập hóa đơn</a></div>}else if(terminal){<div class="alert alert-secondary mb-0">Đơn ở trạng thái cuối và không thể mở lại.</div>}@if(Model.NgayCapNhatTrangThai.HasValue){<div class="small text-muted mt-3">Cập nhật @Model.NgayCapNhatTrangThai.Value.ToString("dd/MM/yyyy HH:mm") bởi @(Model.NguoiCapNhatTrangThai?.HoTen??"Hệ thống")</div>}</div></div></div>
<div class="col-lg-4"><div class="card card-body mb-3"><h5>Khách hàng</h5><p><strong>@Model.HoTenNguoiNhan</strong><br/>@Model.SoDienThoaiNguoiNhan<br/>@Model.DiaChiGiaoHang</p></div><div class="card card-body"><h5>Thanh toán</h5><div class="d-flex justify-content-between"><span>Tiền hàng</span><span>@Model.TongTienHang.ToString("N0") đ</span></div><div class="d-flex justify-content-between"><span>Phí vận chuyển</span><span>@Model.PhiVanChuyen.ToString("N0") đ</span></div><div class="d-flex justify-content-between fs-5 fw-bold border-top mt-2 pt-2"><span>Tổng</span><span>@Model.TongThanhToan.ToString("N0") đ</span></div></div></div></div>
