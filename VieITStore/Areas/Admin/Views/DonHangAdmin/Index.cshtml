@model IReadOnlyList<DonHang>
@{
    ViewData["Title"] = "Đơn hàng tại quầy";
    var keyword = ViewBag.TuKhoa as string;
    var selectedStatus = ViewBag.TrangThai as TrangThaiDonHang?;
}

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-7">
                <label for="q" class="form-label">Tìm kiếm</label>
                <input id="q" name="q" value="@keyword" class="form-control" placeholder="Mã đơn, tên hoặc số điện thoại khách hàng" />
            </div>
            <div class="col-md-3">
                <label for="trangThai" class="form-label">Trạng thái</label>
                <select id="trangThai" name="trangThai" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                    <option value="1" selected="@(selectedStatus == TrangThaiDonHang.ChoXacNhan)">Chờ xác nhận</option>
                    <option value="2" selected="@(selectedStatus == TrangThaiDonHang.DaXacNhan)">Đã xác nhận</option>
                    <option value="3" selected="@(selectedStatus == TrangThaiDonHang.DangGiao)">Đang giao</option>
                    <option value="4" selected="@(selectedStatus == TrangThaiDonHang.DaGiao)">Đã giao</option>
                    <option value="5" selected="@(selectedStatus == TrangThaiDonHang.HoanThanh)">Hoàn thành</option>
                    <option value="6" selected="@(selectedStatus == TrangThaiDonHang.DaHuy)">Đã hủy</option>
                    <option value="7" selected="@(selectedStatus == TrangThaiDonHang.YeuCauTraHang)">Yêu cầu trả hàng</option>
                </select>
            </div>
            <div class="col-md-2 d-grid"><button class="btn btn-primary"><i class="fas fa-search"></i> Tra cứu</button></div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Danh sách đơn tại quầy</h5>
    <a asp-controller="BanHangTaiQuay" asp-action="Index" class="btn btn-success"><i class="fas fa-plus"></i> Tạo đơn tại quầy</a>
</div>
<div class="card"><div class="table-responsive">
    <table class="table table-hover mb-0">
        <thead class="table-light"><tr><th>Mã đơn</th><th>Khách hàng</th><th>Số điện thoại</th><th>Ngày tạo</th><th class="text-end">Tổng tiền</th><th>Trạng thái</th><th>Thanh toán</th><th></th></tr></thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="8" class="text-center text-muted py-4">Không tìm thấy đơn hàng tại quầy phù hợp.</td></tr>
        }
        @foreach (var order in Model)
        {
            var statusText = order.TrangThai switch
            {
                TrangThaiDonHang.ChoXacNhan => "Chờ xác nhận",
                TrangThaiDonHang.DaXacNhan => "Đã xác nhận",
                TrangThaiDonHang.HoanThanh => "Hoàn thành",
                TrangThaiDonHang.DaHuy => "Đã hủy",
                _ => order.TrangThai.ToString()
            };
            var badge = order.TrangThai switch
            {
                TrangThaiDonHang.HoanThanh => "bg-success",
                TrangThaiDonHang.DaHuy => "bg-danger",
                TrangThaiDonHang.DaXacNhan => "bg-info text-dark",
                _ => "bg-warning text-dark"
            };
            <tr>
                <td><strong>@order.MaDonHang</strong></td>
                <td>@order.HoTenNguoiNhan</td>
                <td>@order.SoDienThoaiNguoiNhan</td>
                <td>@order.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                <td class="text-end fw-bold">@order.TongThanhToan.ToString("N0") đ</td>
                <td><span class="badge @badge">@statusText</span></td>
                <td><span class="badge @(order.DaThanhToan ? "bg-success" : "bg-secondary")">@(order.DaThanhToan ? "Đã thanh toán" : "Chưa thanh toán")</span></td>
                <td class="text-end"><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a></td>
            </tr>
        }
        </tbody>
    </table>
</div></div>
