@model IReadOnlyList<DonHang>
@{ViewData["Title"]="Quản lý đơn hàng";var selectedStatus=ViewBag.TrangThai as TrangThaiDonHang?;}
<div class="card card-body mb-3"><form method="get" class="row g-2 align-items-end"><div class="col-lg-4"><label class="form-label">Tìm kiếm</label><input name="q" value="@ViewBag.TuKhoa" class="form-control" placeholder="Mã đơn, tên hoặc số điện thoại"/></div><div class="col-lg-2"><label class="form-label">Trạng thái</label><select name="trangThai" asp-items="Html.GetEnumSelectList<TrangThaiDonHang>()" class="form-select"><option value="">Tất cả</option></select></div><div class="col-lg-2"><label class="form-label">Từ ngày</label><input type="date" name="tuNgay" value="@((ViewBag.TuNgay as DateTime?)?.ToString("yyyy-MM-dd"))" class="form-control"/></div><div class="col-lg-2"><label class="form-label">Đến ngày</label><input type="date" name="denNgay" value="@((ViewBag.DenNgay as DateTime?)?.ToString("yyyy-MM-dd"))" class="form-control"/></div><div class="col-lg-2"><button class="btn btn-primary w-100">Tra cứu</button></div></form></div>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Kênh bán</th><th>Ngày đặt</th><th class="text-end">Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="7" class="text-center text-muted py-4">Không tìm thấy đơn hàng phù hợp.</td></tr>}@foreach(var x in Model){<tr><td><strong>@x.MaDonHang</strong><div class="small">@x.SoDienThoaiNguoiNhan</div></td><td>@x.HoTenNguoiNhan</td><td><span class="badge bg-secondary">@x.KenhBan</span></td><td>@x.NgayDat.ToString("dd/MM/yyyy HH:mm")</td><td class="text-end fw-bold">@x.TongThanhToan.ToString("N0") đ</td><td>@DonHangAdminController.StatusText(x.TrangThai)</td><td class="text-end"><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a></td></tr>}</tbody></table></div></div>
