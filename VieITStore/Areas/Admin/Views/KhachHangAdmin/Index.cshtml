@model List<KhachHangAdminItemVM>
@{ ViewData["Title"]="Quản lý khách hàng"; }
<form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col-md-7"><label for="q" class="visually-hidden">Từ khóa</label><input id="q" name="q" value="@ViewBag.Q" class="form-control" placeholder="Tên, email hoặc số điện thoại"/></div><div class="col-md-3"><label for="trangThai" class="visually-hidden">Trạng thái</label><select id="trangThai" name="trangThai" class="form-select"><option value="">Tất cả trạng thái</option><option value="true">Đang hoạt động</option><option value="false">Đã khóa</option></select></div><div class="col-md-2"><button class="btn btn-primary w-100">Tìm kiếm</button></div></div></form>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Khách hàng</th><th>Liên hệ</th><th>Ngày tạo</th><th class="text-end">Số đơn</th><th class="text-end">Tổng chi tiêu</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.HoTen</strong></td><td>@x.Email<div class="small">@x.SoDienThoai</div></td><td>@x.NgayTao.ToString("dd/MM/yyyy")</td><td class="text-end">@x.SoDon</td><td class="text-end fw-bold">@x.TongChiTieu.ToString("N0") đ</td><td><span class="badge @(x.TrangThai?"bg-success":"bg-secondary")">@(x.TrangThai?"Hoạt động":"Đã khóa")</span></td><td class="text-end"><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a><form asp-action="ChuyenTrangThai" method="post" class="d-inline"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm @(x.TrangThai?"btn-outline-danger":"btn-outline-success")" onclick="return confirm('Xác nhận thay đổi trạng thái?')">@(x.TrangThai?"Khóa":"Kích hoạt")</button></form></td></tr>}</tbody></table></div></div>
