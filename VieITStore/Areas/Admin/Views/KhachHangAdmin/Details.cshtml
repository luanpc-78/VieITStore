@model KhachHangAdminDetailsVM
@{ ViewData["Title"]="Chi tiết khách hàng"; var u=Model.KhachHang.NguoiDung!; }
<div class="row g-3"><div class="col-lg-4"><div class="card card-body"><h5>@u.HoTen</h5><dl><dt>Email</dt><dd>@u.Email</dd><dt>Số điện thoại</dt><dd>@u.SoDienThoai</dd><dt>Ngày sinh</dt><dd>@Model.KhachHang.NgaySinh?.ToString("dd/MM/yyyy")</dd></dl></div><div class="card card-body mt-3"><h6>Địa chỉ giao hàng</h6>@if(Model.KhachHang.DiaChiGiaoHangs.Any()){@foreach(var a in Model.KhachHang.DiaChiGiaoHangs){<div class="border-bottom py-2"><strong>@a.HoTenNguoiNhan · @a.SoDienThoai</strong><div>@a.DiaChiChiTiet, @a.PhuongXa, @a.QuanHuyen, @a.TinhThanh</div></div>}}else{<p class="text-muted mb-0">Chưa có địa chỉ.</p>}</div></div><div class="col-lg-8"><div class="card"><div class="card-header"><strong>Lịch sử đơn hàng</strong></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Trạng thái</th><th class="text-end">Tổng tiền</th></tr></thead><tbody>@foreach(var d in Model.DonHangs){<tr><td><a asp-controller="DonHangAdmin" asp-action="Details" asp-route-id="@d.Id">@d.MaDonHang</a></td><td>@d.NgayDat.ToString("dd/MM/yyyy HH:mm")</td><td>@d.TrangThai</td><td class="text-end">@d.TongThanhToan.ToString("N0") đ</td></tr>}</tbody></table></div></div></div></div>
