@model List<VieITStore.Models.Entities.PhieuNhap>
@{
    ViewData["Title"] = "Quản lý nhập hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-0">Danh sách phiếu nhập</h5>
    <a href="@Url.Action("Create")" class="btn btn-success"><i class="fas fa-plus"></i> Nhập hàng mới</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã phiếu</th>
                    <th>Nhà cung cấp</th>
                    <th>Ngày nhập</th>
                    <th>Người nhập</th>
                    <th class="text-end">Tổng tiền</th>
                    <th width="100">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pn in Model)
                {
                    <tr>
                        <td><strong>@pn.MaPhieuNhap</strong></td>
                        <td>@pn.NhaCungCap?.TenNCC</td>
                        <td>@pn.NgayNhap.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@pn.NguoiNhap?.HoTen</td>
                        <td class="text-end fw-bold">@pn.TongTien.ToString("N0") đ</td>
                        <td>
                            <a href="#" class="btn btn-primary btn-sm"><i class="fas fa-eye"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>