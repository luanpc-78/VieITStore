@model List<DanhGia>
@{ViewData["Title"]="Duyệt đánh giá";}
<form method="get" class="card card-body mb-3"><div class="row g-2"><div class="col-md-8"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Sản phẩm, khách hàng hoặc nội dung"/></div><div class="col-md-2"><select name="hienThi" class="form-select"><option value="">Tất cả</option><option value="true">Đang hiện</option><option value="false">Đang ẩn</option></select></div><div class="col-md-2"><button class="btn btn-primary w-100">Lọc</button></div></div></form>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Sản phẩm</th><th>Khách hàng</th><th>Đánh giá</th><th>Ngày</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.SanPham?.TenSanPham</td><td>@x.KhachHang?.NguoiDung?.HoTen</td><td><div class="text-warning">@string.Concat(Enumerable.Repeat("★",x.SoSao))</div><div>@x.NoiDung</div></td><td>@x.NgayDanhGia.ToString("dd/MM/yyyy")</td><td><span class="badge @(x.HienThi?"bg-success":"bg-secondary")">@(x.HienThi?"Đang hiện":"Đang ẩn")</span></td><td><form asp-action="ChuyenTrangThai" method="post"><input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-primary">@(x.HienThi?"Ẩn":"Hiện")</button></form></td></tr>}</tbody></table></div></div>
