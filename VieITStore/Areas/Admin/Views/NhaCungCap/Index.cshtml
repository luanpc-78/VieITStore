@model IReadOnlyList<VieITStore.Models.Entities.NhaCungCap>
@{
    ViewData["Title"] = "Nhà cung cấp";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-1">Quản lý nhà cung cấp</h4>
        <div class="text-muted">Theo dõi nguồn hàng và trạng thái hợp tác.</div>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Thêm nhà cung cấp</a>
</div>

<div class="card mb-3"><div class="card-body">
    <form method="get" class="row g-2">
        <div class="col-md-10">
            <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo mã, tên, người liên hệ hoặc số điện thoại" />
        </div>
        <div class="col-md-2 d-grid"><button class="btn btn-outline-primary"><i class="fas fa-search"></i> Tìm kiếm</button></div>
    </form>
</div></div>

<div class="card"><div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Mã</th><th>Nhà cung cấp</th><th>Liên hệ</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" class="text-center text-muted py-4">Không tìm thấy nhà cung cấp.</td></tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.MaNCC</td>
                    <td><div>@item.TenNCC</div><small class="text-muted">@(item.DiaChi ?? "Chưa có địa chỉ")</small></td>
                    <td><div>@(item.NguoiLienHe ?? "—")</div><small class="text-muted">@(item.SoDienThoai ?? "Chưa có SĐT")</small></td>
                    <td><span class="badge @(item.TrangThai ? "bg-success" : "bg-secondary")">@(item.TrangThai ? "Đang hợp tác" : "Ngừng hợp tác")</span></td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Chi tiết"><i class="fas fa-eye"></i></a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Cập nhật"><i class="fas fa-edit"></i></a>
                        <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button class="btn btn-sm @(item.TrangThai ? "btn-outline-danger" : "btn-outline-success")" onclick="return confirm('@(item.TrangThai ? "Ngừng hợp tác với nhà cung cấp này?" : "Kích hoạt lại nhà cung cấp này?")')">
                                <i class="fas @(item.TrangThai ? "fa-ban" : "fa-check")"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div></div>
