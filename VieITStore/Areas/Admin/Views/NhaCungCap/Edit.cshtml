@model VieITStore.Models.ViewModels.NhaCungCapVM
@{
    ViewData["Title"] = "Cập nhật nhà cung cấp";
}

<div class="card"><div class="card-header"><strong>Cập nhật nhà cung cấp</strong></div><div class="card-body">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden" />
        <partial name="_Form" model="Model" />
        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-primary"><i class="fas fa-save"></i> Lưu thay đổi</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
