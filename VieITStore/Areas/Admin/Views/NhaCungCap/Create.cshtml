@model VieITStore.Models.ViewModels.NhaCungCapVM
@{
    ViewData["Title"] = "Thêm nhà cung cấp";
}

<div class="card"><div class="card-header"><strong>Thêm nhà cung cấp</strong></div><div class="card-body">
    <form asp-action="Create" method="post">
        <partial name="_Form" model="Model" />
        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-primary"><i class="fas fa-save"></i> Lưu nhà cung cấp</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
